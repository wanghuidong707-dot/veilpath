name: Veilpath Build Check

on:
  workflow_dispatch:

jobs:
  check:
    runs-on: macos-15

    steps:
      - name: Download source
        uses: actions/checkout@v4

      - name: Check Xcode
        run: |
          xcodebuild -version
          xcode-select -p
          xcodebuild -showsdks

      - name: Check Veilpath project
        run: |
          xcodebuild -list -project Veilpath.xcodeproj

      - name: Check build settings
        run: |
          xcodebuild \
            -project Veilpath.xcodeproj \
            -scheme Veilpath \
            -showBuildSettings \
            CODE_SIGNING_ALLOWED=NO \
            > build-settings.txt

      - name: Save results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: Veilpath-Build-Check
          path: build-settings.txt
          if-no-files-found: ignore
